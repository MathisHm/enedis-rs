# ==============================================================================
# Configuration d'environnement enedis-rs Docker Compose
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Fournisseur Enedis & Sécurité API
# ------------------------------------------------------------------------------
# Choix du fournisseur : "sge" (SOAP mTLS) ou "dataconnect" (REST OAuth2)
ENEDIS_PROVIDER=sge

# Clé secrète requise pour authentifier les appels vers l'API REST (X-API-Key ou Bearer)
ENEDIS_API_KEY=change_me_to_a_secure_token

# ------------------------------------------------------------------------------
# 2. Identifiants Enedis SGE (SOAP mTLS)
# ------------------------------------------------------------------------------
# En mode démo local, le simulateur mock interne est utilisé :
ENEDIS_ENDPOINT=http://enedis-mock:9090/services/

# Pour basculer vers les serveurs réels de production Enedis SGE :
# ENEDIS_ENDPOINT=https://sge-services.enedis.fr/services/
# ENEDIS_CERT_P12=/etc/enedis/certs/mon_certificat.p12
# ENEDIS_CERT_PASSWORD=mon_mot_de_passe_secret

# ------------------------------------------------------------------------------
# 3. Identifiants Enedis Data Connect (REST OAuth2)
# ------------------------------------------------------------------------------
# En mode démo local, le simulateur mock interne est utilisé :
ENEDIS_DATA_CONNECT_URL=http://enedis-mock:9090

# Pour basculer vers les serveurs réels de production Enedis Data Connect :
# ENEDIS_DATA_CONNECT_URL=https://ext.prod.api.enedis.fr
# ENEDIS_DATA_CONNECT_CLIENT_ID=votre_client_id_oauth2
# ENEDIS_DATA_CONNECT_CLIENT_SECRET=votre_client_secret_oauth2
# ENEDIS_DATA_CONNECT_TOKEN=votre_direct_bearer_token_optionnel

# ------------------------------------------------------------------------------
# 4. Base de données PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=enedis
POSTGRES_PASSWORD=enedis_password
POSTGRES_DB=enedis_db

# ------------------------------------------------------------------------------
# 5. Broker MQTT & Home Assistant Auto-Discovery
# ------------------------------------------------------------------------------
MQTT_BROKER=mqtt://mosquitto:1883
MQTT_PREFIX=enedis
MQTT_USER=
MQTT_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Grafana Observabilité
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
