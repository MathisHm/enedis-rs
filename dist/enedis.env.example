# ==============================================================================
# Configuration d'environnement pour enedis-rs
# Emplacement recommandé : /etc/enedis/enedis.env (chmod 600)
# ==============================================================================

# Niveau de log (ex: error, warn, info, debug, trace)
RUST_LOG=info,enedis_rs=debug

# Persistance des données (SQLite ou PostgreSQL)
# Exemples :
# DATABASE_URL=sqlite:///var/lib/enedis/enedis.db
DATABASE_URL=postgres://enedis:votre_mot_de_passe_db@127.0.0.1:5432/enedis

# Fournisseur Enedis ("sge" ou "dataconnect")
ENEDIS_PROVIDER=dataconnect

# --- Configuration Enedis Data Connect v5 (REST OAuth2) ---
ENEDIS_DATA_CONNECT_URL=https://ext.prod.api.enedis.fr
ENEDIS_DATA_CONNECT_CLIENT_ID=votre_client_id_enedis
ENEDIS_DATA_CONNECT_CLIENT_SECRET=votre_client_secret_enedis
# ENEDIS_DATA_CONNECT_TOKEN=votre_jeton_statique_si_applicable

# --- Configuration Enedis SGE (SOAP mTLS) ---
ENEDIS_ENDPOINT=https://sge-services.enedis.fr/services/
# ENEDIS_CERT_P12=/etc/enedis/certs/client.p12
# ENEDIS_CERT_PASSWORD=mot_de_passe_du_certificat

# --- Configuration MQTT (Home Assistant) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# MQTT_USER=homeassistant
# MQTT_PASSWORD=secret_mqtt
MQTT_PREFIX=enedis

# --- Configuration API Server ---
API_HOST=0.0.0.0
API_PORT=8080
API_AUTH_KEY=definir_une_cle_secrete_longue_et_aleatoire

# --- Configuration Daemon / Cron ---
ENEDIS_CRON=0 4 * * *
